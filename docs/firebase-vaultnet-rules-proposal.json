{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
      }
    },
    "customEntries": {
      "games": {
        ".read": "auth != null",
        "$entryId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['userId', 'username', 'title', 'url', 'icon', 'category', 'description', 'rating', 'createdAt', 'updatedAt'])"
        }
      },
      "websites": {
        ".read": "auth != null",
        "$entryId": {
          ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['userId', 'username', 'title', 'url', 'icon', 'category', 'description', 'rating', 'createdAt', 'updatedAt'])"
        }
      }
    },
    "System": {
      "latestVersion": { ".read": true, ".write": false }
    },
    "stash": {
      "games": { ".read": true, ".write": false }
    },
    "dailyChallenge": {
      ".read": "auth != null",
      "$date": { ".write": "auth != null && !data.exists()" }
    },
    "siteStats": {
      "visits": { ".read": true, ".write": true }
    },
    "vaultnet": {
      "presence": {
        ".read": "auth != null",
        "$clientId": {
          ".write": "auth != null && ((newData.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.hasChildren(['clientId', 'uid', 'username', 'activity', 'lastSeen'])",
          "clientId": { ".validate": "newData.isString() && newData.val() === $clientId" },
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "avatar": { ".validate": "newData.isString() && (newData.val() === '🧑‍💻' || newData.val() === '👾' || newData.val() === '🦊' || newData.val() === '🐱' || newData.val() === '🐸' || newData.val() === '🐼' || newData.val() === '🚀' || newData.val() === '🌙')" },
          "status": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "activity": { ".validate": "newData.hasChildren(['app'])" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "chat": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['id', 'uid', 'clientId', 'username', 'text', 'timestamp'])",
          "id": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "clientId": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "username": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        ".indexOn": ["timestamp"]
      }
    }
  }
}